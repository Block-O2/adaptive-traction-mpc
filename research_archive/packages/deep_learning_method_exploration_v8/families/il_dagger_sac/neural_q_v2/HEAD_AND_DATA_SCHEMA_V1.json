{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v8.neuralq_v2.source_only_contract_schema.v1",
  "description": "Schema only; neither a policy/checkpoint nor real/synthetic call approval.",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "future_call_authorization": {
      "type": "object",
      "required": ["schema", "approved", "scope", "data_sha256", "head_source_sha256", "ridge_source_sha256", "contract_sha256", "feature_names_sha256", "full_recipe_sha256", "local_stop_unix"],
      "properties": {
        "schema": {"const": "v8.neuralq_v2.explicit_call_authorization.v1"},
        "approved": {"const": true},
        "scope": {"enum": ["SYNTHETIC_MATH_ONLY", "OFFLINE_FROZEN64_ONLY"]},
        "data_sha256": {"type": "string"},
        "head_source_sha256": {"$ref": "#/$defs/sha256"},
        "ridge_source_sha256": {"$ref": "#/$defs/sha256"},
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "feature_names_sha256": {"$ref": "#/$defs/sha256"},
        "full_recipe_sha256": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
        "local_stop_unix": {"type": "number", "maximum": 1793114740.0}
      }
    },
    "training_manifest": {
      "type": "object",
      "required": ["data_sha256", "full_recipe_sha256", "feature_names_sha256", "all_rows_complete_original_evidence", "train_row_indices", "train_source_record_sha256", "train_case_sha256", "input_normalization_fit_case_sha256", "target_scale_fit_row_sha256"],
      "properties": {
        "data_sha256": {"type": "string"},
        "all_rows_complete_original_evidence": {"const": true},
        "train_row_indices": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 63}},
        "train_source_record_sha256": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
        "train_case_sha256": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
        "input_normalization_fit_case_sha256": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
        "target_scale_fit_row_sha256": {"type": "array", "items": {"$ref": "#/$defs/sha256"}}
      }
    },
    "synthetic_training_manifest": {
      "type": "object",
      "required": ["data_sha256", "feature_names_sha256", "full_recipe_sha256", "all_rows_synthetic_fixture"],
      "properties": {
        "data_sha256": {"type": "string", "pattern": "^SYNTHETIC_ONLY_"},
        "all_rows_synthetic_fixture": {"const": true},
        "all_rows_complete_original_evidence": {"const": false},
        "feature_names_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "head_checkpoint": {
      "type": "object",
      "required": ["schema", "architecture", "target", "feature_names", "input_normalization", "output_normalization", "seed", "params", "adam_m", "adam_v", "initialization_rng_state", "training_manifest", "action_contracts", "full_recipe_sha256", "approval_scope", "head_source_sha256", "optimizer", "counters"],
      "properties": {
        "schema": {"const": "v8.neuralq_v2.independent_terminal_head.v1"},
        "architecture": {"enum": ["LINEAR", "TANH16"]},
        "target": {"enum": ["RETURN", "RISK", "JF_FIXED", "JM_FIXED", "JF_CENTERED", "JM_CENTERED"]},
        "feature_names": {"type": "array", "minItems": 25, "maxItems": 39, "uniqueItems": true, "items": {"type": "string"}},
        "seed": {"type": "integer"},
        "training_manifest": {"oneOf": [{"$ref": "#/$defs/training_manifest"}, {"$ref": "#/$defs/synthetic_training_manifest"}]},
        "params": {"type": "object"}, "adam_m": {"type": "object"}, "adam_v": {"type": "object"},
        "counters": {"type": "object"},
        "approval_scope": {"enum": ["SYNTHETIC_MATH_ONLY", "OFFLINE_FROZEN64_ONLY"]},
        "head_source_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "actual_model_calls_in_this_source_delivery": 0,
  "runtime_finite_shape_and_identity_checks_required_in_addition_to_schema": true
}
